# Ejemplo de variables de entorno. NUNCA pongas valores reales aquí.
# Copia a .env.local (no se versiona) para desarrollo y configura los secretos
# en el panel de Supabase (Edge Functions > Secrets) para producción.

# ---- Públicas (pueden ir en el frontend) ----
# URL del proyecto Supabase, p. ej. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Clave anónima (publishable). Solo permite lo que las políticas RLS dejan.
SUPABASE_ANON_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_ENV=sandbox            # sandbox | live

# ---- SECRETOS (solo backend / Edge Functions, nunca en el frontend) ----
# Clave service role: salta RLS. Úsala solo en Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Firma de URLs de descarga y hash de IP.
DOWNLOAD_URL_SECRET=
IP_HASH_SALT=
# Tiempo de vida de las URLs firmadas, en segundos.
SIGNED_URL_TTL_SECONDS=300
# Orígenes permitidos para CORS (GitHub Pages).
ALLOWED_ORIGINS=https://etner249.github.io
